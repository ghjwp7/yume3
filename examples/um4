#!/bin/sh
#$Id: um4 7 2009-02-25 15:19:11Z j-waldby $

# 2026-06-09 - jiw - change "firefox" to "xdg-open" which is supposed
# to send URL to default browser

[ "$YUME" ] || YUME=$(which yume)

# yume example - Drop a URL like http://www.ebay.com/
# or an ebay# like 227364381941 on a button and open it via xdg-open
# The ebay# lookup format shown here worked ok on 24 Feb 2009.
$YUME -ti $0  -bu -ex -la 'Clip URL → browser'\
  'xdg-open "$(xclip -o | tr -d '"'\n'"')"'\
  -la 'Ebay# → browser' 'xdg-open "http://cgi.ebay.com/ws/eBayISAPI.dll?ViewItem&item=`xclip -o`"' &

# Explanation of 'xdg-open "$(xclip -o | tr -d '"'\n'"')"' sequence:

# The 'xdg-open "$(xclip -o | tr -d ' part of the sequence gets
# concatenated to the front of "'\n'", and ')"' gets concatenated to
# the rear.  This gives us
#     xdg-open "$(xclip -o | tr -d '\n')"
# as a button-command parameter to yume.

# Within the xdg-open "$(xclip -o | tr -d '\n')" command,
# xdg-open is a standard Unix utility to open a URL or filename
# in user's chosen browser or in an extension-selected utility.

# xclip -o  returns a text string with current clipboard contents.
# tr -d '\n' uses tr to delete newlines.  tr = translate, -d = delete.
 
# Note, 'xdg-open "$(xclip -o | tr -d '"'\n'"')"' was changed to this
# from  'xdg-open "`xclip -o | tr -d '"'\n'"'`"' on 2026-06-09